<Window x:Class="GearDown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GearDown"
        MinWidth="420" MinHeight="600"
        Width="500" Height="680"
        Icon="fan.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0A0A0A">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#141414"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#858585"/>
        
        <Color x:Key="GlowGreen">#00E65C</Color>
        
        <LinearGradientBrush x:Key="ToxicGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00FF66" Offset="0.0"/>
            <GradientStop Color="#00B347" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFCC00" Offset="0.0"/>
            <GradientStop Color="#D9A600" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="20" Height="20" Background="#111111" BorderBrush="{TemplateBinding Foreground}" BorderThickness="4" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="34"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid SnapsToDevicePixels="True">
                            <Border Height="6" Background="#262626" CornerRadius="3" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" Opacity="0.85">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" Height="6" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}" Foreground="{TemplateBinding Foreground}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HardwareCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E1E" Offset="0.0"/>
                <GradientStop Color="#0A0A0A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="GEAR DOWN" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="NATIVE HARDWARE GOVERNOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="StatusText" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold" Foreground="#00E65C" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    
                    <Border Style="{StaticResource HardwareCard}" Margin="0,0,0,16" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="GpuNameText" Text="DETECTING GPU..." FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                <TextBlock Text="Temperature" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Column="1" x:Name="TempText" Text="-- °C" FontSize="48" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <StaticResource ResourceKey="ToxicGradient"/>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{StaticResource GlowGreen}" BlurRadius="12" ShadowDepth="0" Opacity="0.2"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource HardwareCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CPU POWER STATE LIMIT" FontSize="12" FontWeight="SemiBold" Foreground="#FFCC00"/>
                                <TextBlock x:Name="CpuSliderValueText" Text="100 %" FontSize="14" FontWeight="Bold" Foreground="#FFCC00" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Caps maximum processor scaling state." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,15"/>
                            
                            <Slider x:Name="CpuPowerSlider" Minimum="50" Maximum="100" Value="100" 
                                    TickFrequency="1" SmallChange="1" LargeChange="5" 
                                    Foreground="{StaticResource WarningGradient}" ValueChanged="CpuSlider_ValueChanged"/>
                            
                            <TextBlock x:Name="CpuStatusText" Text="SYSTEM: 100% (DEFAULT)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HardwareCard}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="GPU CLOCK FREQUENCY" FontSize="12" FontWeight="SemiBold" Foreground="#00FF66"/>
                                <TextBlock x:Name="SliderValueText" Text="2100 MHz" FontSize="14" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Caps Max Clock Frequency." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,15"/>
                            
                            <Slider x:Name="FreqSlider" Minimum="210" Maximum="3500" Value="1800" 
                                    TickFrequency="10" SmallChange="10" LargeChange="50" 
                                    Foreground="{StaticResource ToxicGradient}" ValueChanged="FreqSlider_ValueChanged"/>
                            
                            <TextBlock x:Name="GpuStatusText" Text="SYSTEM: DEFAULT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <UniformGrid Grid.Row="3" Columns="2" Margin="0,20,0,0">
                <Button Content="Apply Settings" Margin="0,0,5,0" Background="{StaticResource TextPrimary}" Style="{StaticResource ModernButton}" Click="Apply_Click"/>
                <Button Content="Restore Defaults" Margin="5,0,0,0" Background="#1E1E1E" Click="Reset_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#333333"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#555555"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>