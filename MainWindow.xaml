<Window x:Class="GearDown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gear Down"
        MinWidth="420" MinHeight="640"
        Width="460" Height="720"
        Icon="fan.ico"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ThinProgressAmber" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{DynamicResource BrushAmber}"/>
                <Setter Property="Background" Value="{DynamicResource BrushProgressAmberTrack}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="6"/>
            </Style>

            <Style x:Key="ThinProgressTeal" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{DynamicResource BrushTeal}"/>
                <Setter Property="Background" Value="{DynamicResource BrushProgressTealTrack}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="6"/>
            </Style>

            <Style x:Key="SliderRepeatTransparent" TargetType="RepeatButton">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderDecreaseAmber" TargetType="RepeatButton" BasedOn="{StaticResource SliderRepeatTransparent}">
                <Setter Property="Background" Value="{DynamicResource BrushAmber}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Height="8" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderDecreaseTeal" TargetType="RepeatButton" BasedOn="{StaticResource SliderRepeatTransparent}">
                <Setter Property="Background" Value="{DynamicResource BrushTeal}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Height="8" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderIncreaseTrack" TargetType="RepeatButton" BasedOn="{StaticResource SliderRepeatTransparent}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="8" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FluentSliderThumb" TargetType="Thumb">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse Width="22" Height="22"
                                     StrokeThickness="2"
                                     Stroke="{TemplateBinding Foreground}"
                                     Fill="{DynamicResource BrushSurface2}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource ColorThumbShadow}" BlurRadius="6" ShadowDepth="1" Opacity="{DynamicResource ShadowOpacityThumb}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FluentCpuSlider" TargetType="Slider">
                <Setter Property="Foreground" Value="{DynamicResource BrushAmber}"/>
                <Setter Property="Background" Value="{DynamicResource BrushSliderCpuTrack}"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="TrackBg" CornerRadius="4" Background="{TemplateBinding Background}" Height="8" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <Track x:Name="PART_Track" Focusable="False" IsDirectionReversed="False" Margin="{TemplateBinding Padding}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderDecreaseAmber}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource FluentSliderThumb}" Foreground="{DynamicResource BrushAmber}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderIncreaseTrack}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FluentGpuSlider" TargetType="Slider">
                <Setter Property="Foreground" Value="{DynamicResource BrushTeal}"/>
                <Setter Property="Background" Value="{DynamicResource BrushSliderGpuTrack}"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="TrackBg" CornerRadius="4" Background="{TemplateBinding Background}" Height="8" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <Track x:Name="PART_Track" Focusable="False" IsDirectionReversed="False" Margin="{TemplateBinding Padding}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderDecreaseTeal}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource FluentSliderThumb}" Foreground="{DynamicResource BrushTeal}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderIncreaseTrack}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ApplyFooterButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BrushApplyFooterBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushApplyFooterBorder}"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushTeal}"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushApplyFooterHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushApplyFooterPressedBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ResetFooterButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BrushResetFooterBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource BrushRedSoft}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushResetFooterHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushResetFooterPressedBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThemeToggleCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="ToggleHost"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="{DynamicResource BrushSurface1}"
                                    BorderBrush="{DynamicResource BrushTextMuted}"
                                    BorderThickness="1">
                                <TextBlock x:Name="ThemeGlyph"
                                           Text="🌙"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ThemeGlyph" Property="Text" Value="💡"/>
                                    <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource BrushTeal}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource BrushTeal}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ToggleHost" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + theme toggle -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="GEAR DOWN" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushTeal}" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox Grid.Column="1"
                      x:Name="LightThemeCheckBox"
                      Style="{StaticResource ThemeToggleCheckBoxStyle}"
                      VerticalAlignment="Center"
                      ToolTip="Toggle light/dark mode"
                      Checked="ThemeLight_Changed"
                      Unchecked="ThemeLight_Changed"/>
        </Grid>

        <!-- Status card -->
        <Border Grid.Row="1" Background="{DynamicResource BrushStatusCardBg}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ColorCardShadow}" BlurRadius="16" ShadowDepth="2" Opacity="{DynamicResource ShadowOpacityStatus}"/>
            </Border.Effect>
            <TextBlock x:Name="StatusText" Text="System Ready" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
        </Border>

        <!-- Temp center + flanked progress -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="CpuPowerProgress" Grid.Row="0" Grid.Column="0"
                         Style="{StaticResource ThinProgressAmber}"
                         Minimum="50" Maximum="100"
                         Value="{Binding ElementName=CpuPowerSlider, Path=Value, Mode=OneWay}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>

            <TextBlock x:Name="TempText" Grid.Row="0" Grid.Column="1"
                       Text="-- °C" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource BrushTeal}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorTeal}" BlurRadius="18" ShadowDepth="0" Opacity="{DynamicResource ShadowOpacityTempGlow}"/>
                </TextBlock.Effect>
            </TextBlock>

            <ProgressBar x:Name="GpuFreqProgress" Grid.Row="0" Grid.Column="2"
                         Style="{StaticResource ThinProgressTeal}"
                         Minimum="210" Maximum="3500"
                         Value="{Binding ElementName=FreqSlider, Path=Value, Mode=OneWay}"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU power" FontSize="10" Foreground="{DynamicResource BrushAmber}" HorizontalAlignment="Center" Margin="0,6,8,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="GPU temp" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="GPU frequency" FontSize="10" Foreground="{DynamicResource BrushTeal}" HorizontalAlignment="Center" Margin="8,6,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Background="Transparent">
            <StackPanel>
                <Border Background="{DynamicResource BrushSurface1}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorCardShadow}" BlurRadius="12" ShadowDepth="1" Opacity="{DynamicResource ShadowOpacityCard}"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Content="CPU max power state" Foreground="{DynamicResource BrushAmber}" FontWeight="SemiBold" Padding="0" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Caps Windows max processor state. 100% allows Turbo." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" x:Name="CpuStatusText" Text="CPU: 100% (Default)" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>

                        <Slider x:Name="CpuPowerSlider" Grid.Row="3"
                                Minimum="50" Maximum="100" Value="100" TickFrequency="5"
                                Style="{StaticResource FluentCpuSlider}"
                                ValueChanged="CpuSlider_ValueChanged"/>

                        <TextBlock Grid.Row="4" x:Name="CpuSliderValueText" Text="100 %"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushAmber}"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource BrushSurface1}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorCardShadow}" BlurRadius="12" ShadowDepth="1" Opacity="{DynamicResource ShadowOpacityCard}"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Content="GPU max frequency" Foreground="{DynamicResource BrushTeal}" FontWeight="SemiBold" Padding="0" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Dynamic range — idle can drop toward 210 MHz when limited." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" x:Name="GpuStatusText" Text="GPU: Default" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>

                        <Slider x:Name="FreqSlider" Grid.Row="3"
                                Minimum="210" Maximum="3500" Value="2100" TickFrequency="50"
                                Style="{StaticResource FluentGpuSlider}"
                                ValueChanged="FreqSlider_ValueChanged"/>

                        <TextBlock Grid.Row="4" x:Name="SliderValueText" Text="2100 MHz"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTeal}"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <UniformGrid Grid.Row="4" Columns="2" Margin="0,12,0,0">
            <Button Content="Apply" Margin="0,0,6,0" Style="{StaticResource ApplyFooterButtonStyle}" Click="Apply_Click"/>
            <Button Content="Reset" Margin="6,0,0,0" Style="{StaticResource ResetFooterButtonStyle}" Click="Reset_Click"/>
        </UniformGrid>
    </Grid>
</Window>
