<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Slightly deeper accents for contrast on light surfaces -->
    <Color x:Key="ColorTeal">#25D366</Color>
    <Color x:Key="ColorAmber">#D97706</Color>
    <Color x:Key="ColorRedSoft">#DC2626</Color>

    <Color x:Key="ColorSurface0">#F3F4F6</Color>
    <Color x:Key="ColorSurface1">#FFFFFF</Color>
    <Color x:Key="ColorSurface2">#E5E7EB</Color>
    <Color x:Key="ColorTextPrimary">#111827</Color>

    <SolidColorBrush x:Key="BrushWindowBg" Color="{StaticResource ColorSurface0}"/>
    <SolidColorBrush x:Key="BrushSurface1" Color="{StaticResource ColorSurface1}"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="{StaticResource ColorSurface2}"/>
    <SolidColorBrush x:Key="BrushTeal" Color="{StaticResource ColorTeal}"/>
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}"/>
    <SolidColorBrush x:Key="BrushRedSoft" Color="{StaticResource ColorRedSoft}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#99000000"/>

    <SolidColorBrush x:Key="BrushCodeStatusSaved" Color="#0D9488"/>
    <SolidColorBrush x:Key="BrushCodeStatusApplied" Color="#374151"/>
    <SolidColorBrush x:Key="BrushCodeStatusReset" Color="#111827"/>

    <LinearGradientBrush x:Key="BrushStatusCardBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E5E7EB" Offset="0"/>
        <GradientStop Color="#F9FAFB" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrushProgressAmberTrack" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BrushProgressTealTrack" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="BrushSliderCpuTrack" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BrushSliderGpuTrack" Color="#D1FAE5"/>

    <SolidColorBrush x:Key="BrushApplyFooterBg" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BrushApplyFooterBorder" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="BrushApplyFooterHoverBg" Color="#DDE4E3"/>
    <SolidColorBrush x:Key="BrushApplyFooterPressedBg" Color="#D1D5DB"/>

    <SolidColorBrush x:Key="BrushResetFooterBg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="BrushResetFooterHoverBg" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="BrushResetFooterPressedBg" Color="#FECACA"/>

    <Color x:Key="ColorCardShadow">#40000000</Color>
    <Color x:Key="ColorThumbShadow">#60000000</Color>
    <sys:Double x:Key="ShadowOpacityCard">0.18</sys:Double>
    <sys:Double x:Key="ShadowOpacityStatus">0.22</sys:Double>
    <sys:Double x:Key="ShadowOpacityThumb">0.25</sys:Double>
    <sys:Double x:Key="ShadowOpacityTempGlow">0.45</sys:Double>
</ResourceDictionary>
