<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="ColorTeal">#25D366</Color>
    <Color x:Key="ColorAmber">#FFB01A</Color>
    <Color x:Key="ColorRedSoft">#E85D5D</Color>

    <Color x:Key="ColorSurface0">#000000</Color>
    <Color x:Key="ColorSurface1">#141414</Color>
    <Color x:Key="ColorSurface2">#1E1E1E</Color>
    <Color x:Key="ColorTextPrimary">#F3F3F3</Color>

    <SolidColorBrush x:Key="BrushWindowBg" Color="{StaticResource ColorSurface0}"/>
    <SolidColorBrush x:Key="BrushSurface1" Color="{StaticResource ColorSurface1}"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="{StaticResource ColorSurface2}"/>
    <SolidColorBrush x:Key="BrushTeal" Color="{StaticResource ColorTeal}"/>
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}"/>
    <SolidColorBrush x:Key="BrushRedSoft" Color="{StaticResource ColorRedSoft}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#99FFFFFF"/>

    <SolidColorBrush x:Key="BrushCodeStatusSaved" Color="#4DD0E1"/>
    <SolidColorBrush x:Key="BrushCodeStatusApplied" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BrushCodeStatusReset" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="BrushStatusCardBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#121212" Offset="0"/>
        <GradientStop Color="#1B1B1B" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrushProgressAmberTrack" Color="#332A1A"/>
    <SolidColorBrush x:Key="BrushProgressTealTrack" Color="#0F2A24"/>
    <SolidColorBrush x:Key="BrushSliderCpuTrack" Color="#332A1A"/>
    <SolidColorBrush x:Key="BrushSliderGpuTrack" Color="#0F2A24"/>

    <SolidColorBrush x:Key="BrushApplyFooterBg" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="BrushApplyFooterBorder" Color="#404040"/>
    <SolidColorBrush x:Key="BrushApplyFooterHoverBg" Color="#333333"/>
    <SolidColorBrush x:Key="BrushApplyFooterPressedBg" Color="#2A2A2A"/>

    <SolidColorBrush x:Key="BrushResetFooterBg" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BrushResetFooterHoverBg" Color="#352020"/>
    <SolidColorBrush x:Key="BrushResetFooterPressedBg" Color="#2A1818"/>

    <Color x:Key="ColorCardShadow">#000000</Color>
    <Color x:Key="ColorThumbShadow">#000000</Color>
    <sys:Double x:Key="ShadowOpacityCard">0.28</sys:Double>
    <sys:Double x:Key="ShadowOpacityStatus">0.35</sys:Double>
    <sys:Double x:Key="ShadowOpacityThumb">0.45</sys:Double>
    <sys:Double x:Key="ShadowOpacityTempGlow">0.65</sys:Double>
</ResourceDictionary>
